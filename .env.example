# MySQL — same server as StudentPortal
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_portal_db_name

# JWT secret for admin panel
ADMIN_JWT_SECRET=change-this-to-a-long-random-string

# Default admin credentials (only used for first-time setup)
ADMIN_SETUP_PASSWORD=change-this
